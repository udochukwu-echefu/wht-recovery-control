# Server-only DeepSeek secret used by app/api/intake for receipt extraction.
DEEPSEEK_API_KEY=

# DeepSeek's current Flash model.
DEEPSEEK_MODEL=deepseek-flash
AI_PROVIDER=auto

# Resend delivery is disabled until a sender domain is verified and configured.
RESEND_API_KEY=
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM=
